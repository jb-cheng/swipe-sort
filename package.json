{
  "name": "agon-preview",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "electron:dev": "npm run build:web && electron electron/main.js",
    "electron:dev:serve": "npm run build:web && electron electron/main.js -- --serve 3456",
    "electron:build": "npm run build:web && electron-builder --win portable",
    "server": "node server/standalone.js --port 3456",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "build": {
    "appId": "com.arcadalabs.file-sorter",
    "productName": "File Sorter",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "services/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.18.6",
    "canvas": "^3.2.3",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-font": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "mammoth": "^1.12.0",
    "music-metadata": "^11.13.0",
    "pdfjs-dist": "^3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.14.1",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-qr-code": "^2.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "private": true
}
